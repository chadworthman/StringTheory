[Unit]
Description=String Theory light show engine
After=network-online.target
Wants=network-online.target

[Service]
User=deploy
WorkingDirectory=/home/deploy/smartlights
ExecStart=/home/deploy/smartlights/venv/bin/python /home/deploy/smartlights/lights.py run
Restart=always
RestartSec=5
MemoryMax=150M
Nice=5

[Install]
WantedBy=multi-user.target

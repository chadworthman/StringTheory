[Unit]
Description=String Theory light show - home network control page (port 8080)
After=network-online.target
Wants=network-online.target

[Service]
User=deploy
WorkingDirectory=/home/deploy/smartlights
ExecStart=/home/deploy/smartlights/venv/bin/python /home/deploy/smartlights/web.py
Restart=always
RestartSec=5
MemoryMax=80M

[Install]
WantedBy=multi-user.target
